# Copy to .env (gitignored). Every variable is optional; config.yaml supplies defaults.

# Answer model: ollama (local) or anthropic (hosted)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=sk-ant-...

# Ollama serves embeddings always, and the answer model when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Vector store location
CHROMA_PERSIST_DIR=./chroma_persistent_db

# HTTP
PORT=8000
CORS_ORIGINS=https://your-domain.example
RATE_LIMIT_PER_MINUTE=10
